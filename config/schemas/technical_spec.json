{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TechnicalSpecification",
  "type": "object",
  "required": ["equipment_name", "model_number", "parameters"],
  "properties": {
    "equipment_name": {
      "type": "string",
      "description": "Name or classification of the equipment/machinery"
    },
    "model_number": {
      "type": "string",
      "description": "Manufacturer model, part, or serial series number"
    },
    "manufacturer": {
      "type": ["string", "null"],
      "description": "Manufacturing entity or brand"
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": {"type": "string"},
          "value": {"type": "string"},
          "unit": {"type": ["string", "null"]},
          "tolerance": {"type": ["string", "null"]}
        }
      }
    },
    "operating_conditions": {
      "type": ["object", "null"],
      "properties": {
        "temp_min_c": {"type": ["number", "null"]},
        "temp_max_c": {"type": ["number", "null"]},
        "input_voltage_v": {"type": ["string", "number", "null"]},
        "rated_current_a": {"type": ["string", "number", "null"]}
      }
    },
    "certification_standards": {
      "type": "array",
      "items": {"type": "string"}
    },
    "revision_date": {
      "type": ["string", "null"],
      "description": "Document specification revision date"
    }
  }
}
